# Root .gitignore for EcoCart project

# Sensitive credentials & environment variables
.env
.env.local
.env.*.local

# Frontend Node dependencies & build distributions
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
frontend/.vite-inspect

# Backend Maven build outputs
backend/target/
backend/.mvn/
backend/bin/
backend/.settings/
backend/.classpath
backend/.project
backend/*.class

# IDE & Editor caches
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
